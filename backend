from flask import Flask, render_template, request, redirect, url_for
import mysql.connector

app = Flask(__name__)

conn = mysql.connector.connect(
    host="localhost",
    user="root",
    password="7300",
    database="railway"
)

cursor = conn.cursor()

cursor.execute("""
CREATE TABLE IF NOT EXISTS passengers (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(50),
    expressno VARCHAR(20),
    seatno INT
)
""")

conn.commit()

@app.route('/')
def index():
    cursor.execute("SELECT name, expressno, seatno FROM passengers")
    passengers = cursor.fetchall()
    return render_template('index.html', passengers=passengers)

@app.route('/reserve', methods=['POST'])
def reserve():
    name = request.form['name']
    expressno = request.form['train']

    cursor.execute(
        "SELECT COUNT(*) FROM passengers WHERE expressno = %s",
        (expressno,)
    )

    count = cursor.fetchone()[0]

    if count >= 5:
        return "Train is fully booked!", 400

    seatno = count + 1

    cursor.execute(
        "INSERT INTO passengers (name, expressno, seatno) VALUES (%s, %s, %s)",
        (name, expressno, seatno)
    )

    conn.commit()

    return redirect(url_for('index'))

@app.route('/cancel', methods=['POST'])
def cancel():
    name = request.form['name']
    expressno = request.form['train']

    cursor.execute(
        "DELETE FROM passengers WHERE name=%s AND expressno=%s LIMIT 1",
        (name, expressno)
    )

    conn.commit()

    return redirect(url_for('index'))

if __name__ == '__main__':
    app.run(debug=True)
